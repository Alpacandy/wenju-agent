{
  "name": "teachagent",
  "version": "1.0.0",
  "description": "问矩 · 线性代数实验式探究智能助教系统",
  "main": "js/app.js",
  "scripts": {
    "build:math": "node scripts/build-math-renderer.mjs",
    "test": "node tests/run_all_tests.js",
    "test:unit": "node tests/run_all_tests.js --subset=unit",
    "test:integration": "node tests/run_all_tests.js --subset=integration",
    "test:e2e": "node tests/run_all_tests.js --subset=e2e",
    "test:live": "node tests/run_all_tests.js --subset=live",
    "test:cdp": "node tests/e2e/browser_cdp_check.js",
    "dev": "python -m http.server 8000 --bind 127.0.0.1",
    "test:m1": "node tests/scripts/run_m1_gate.js",
    "test:gate": "node tests/scripts/run_m1_gate.js && node tests/unit/test_m2_agent_no_silent_fallback.js",
    "test:m2": "node tests/unit/test_m2_agent_no_silent_fallback.js",
    "audit": "npm audit --json",
    "audit:official": "npm audit --json --registry=https://registry.npmjs.org",
    "server": "node server/src/index.js",
    "dev:server": "node server/src/index.js"
  },
  "keywords": [
    "linear-algebra",
    "educational-ai",
    "deepseek-harness",
    "mcp",
    "affine-geometry"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0 <25.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "mafs": "0.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
